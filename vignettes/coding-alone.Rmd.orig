```{r chunk-setup, echo = FALSE}
knitr::opts_chunk$set (
    echo = FALSE, message = FALSE, warning = FALSE,
    fig.align = "center", fig.width = 9, fig.height = 4, dpi = 150,
    fig.path = "community-attrition-figures/"
)
```

```{r load-package}
library (peerreview)
```

<div class="callout">
This vignette draws on the same large, locally-fetched dataset as
`vignettes/review-dividend.Rmd` (`repo-data-out/`: every GitHub issue ever
opened on ~50,000 repositories across CRAN, npm, PyPI, JOSS and rOpenSci)
that is far too large to ship with the package itself. The vignette you're
reading is precompiled from that data - see
`vignettes/community-attrition.Rmd.orig` in the package source if you want
to re-run the analysis yourself once the underlying data is available (via
Git LFS) from the package repository.
</div>

```{r initial-data-load}
out_dir <- "../repo-data-out"
repo_tbl <- build_repo_tbl (out_dir)
issue_authors_tbl <- readr::read_csv (
    file.path (out_dir, "issue-authors.csv"),
    show_col_types = FALSE, progress = FALSE
)

primary_sources <- c ("cran", "joss", "npm", "pypi", "ropensci")
n_repos_primary <- length (unique (
    repo_tbl$repo_url [repo_tbl$source %in% primary_sources]
))
date_range <- range (as.Date (issue_authors_tbl$created_at), na.rm = TRUE)
```

```{r generate-data, include=FALSE}
contrib_threshold <- 0.01

# Event-count fold-change (rate now vs. Jan 2021), for comparison against
# the person-count version below.
fc_issues <- fold_change_tbl (
    issue_authors_tbl, repo_tbl, primary_sources,
    metric = "issues", contrib_threshold = contrib_threshold
)

# Distinct-author fold-change - this vignette's central metric.
fc_authors <- author_density_fold_change_tbl (
    issue_authors_tbl, repo_tbl, primary_sources,
    contrib_threshold = contrib_threshold
)

fc_compare <- dplyr::inner_join (
    fc_issues, fc_authors,
    by = c ("source", "popularity_stratum"),
    suffix = c ("_issues", "_authors")
)
n_authors_declined <- sum (fc_authors$fold_change < 1)
n_authors_cells <- nrow (fc_authors)
n_issues_declined <- sum (fc_issues$fold_change < 1)
n_authors_fell_more <- sum (fc_compare$fold_change_authors < fc_compare$fold_change_issues)

# Matched-cohort age-vs-calendar-time analysis (same construction as in
# review-dividend, re-run here so this document stands on its own).
cohort_tbl <- cohort_age_rate_tbl (issue_authors_tbl, repo_tbl, primary_sources)

# Q1-vs-Q4 comparison table for the "no corner spared" section.
q1q4_tbl <- fc_authors |>
    dplyr::filter (popularity_stratum %in% c ("Q1", "Q4")) |>
    dplyr::select (source, popularity_stratum, fold_change) |>
    tidyr::pivot_wider (names_from = popularity_stratum, values_from = fold_change) |>
    dplyr::mutate (
        source = unname (SOURCE_DISPLAY_NAME [source]),
        gap = Q4 - Q1
    ) |>
    dplyr::arrange (gap)

# Raw (non-normalised) combined participation, and how much of its
# comparative resilience against the per-repo rate is just more repos
# existing now than in 2021 - referenced in the caveats below.
repo_created <- issue_authors_tbl |>
    dplyr::filter (!is.na (repo_created_at)) |>
    dplyr::distinct (repo_url, repo_created_at) |>
    dplyr::mutate (repo_created_at = peerreview:::floor_month (repo_created_at))
repos_primary <- repo_tbl |>
    dplyr::filter (source %in% primary_sources) |>
    dplyr::distinct (repo_url, .keep_all = TRUE) |>
    dplyr::inner_join (repo_created, by = "repo_url")
n_repos_ref <- sum (repos_primary$repo_created_at <= as.Date ("2021-01-01"), na.rm = TRUE)
n_repos_now <- nrow (repos_primary)
repo_growth_factor <- n_repos_now / n_repos_ref

raw_monthly <- issue_authors_tbl |>
    dplyr::filter (
        repo_url %in% repos_primary$repo_url, contribution <= contrib_threshold
    ) |>
    dplyr::mutate (month = peerreview:::floor_month (created_at)) |>
    dplyr::filter (month >= as.Date ("2016-01-01")) |>
    dplyr::distinct (month, repo_url, author) |>
    dplyr::count (month, name = "n_authors") |>
    dplyr::arrange (month) |>
    dplyr::mutate (roll = peerreview:::trailing_roll_sum (n_authors, 12L))
raw_fold_change <- dplyr::filter (raw_monthly, month == max (month))$roll /
    dplyr::filter (raw_monthly, month == as.Date ("2021-01-01"))$roll
```

