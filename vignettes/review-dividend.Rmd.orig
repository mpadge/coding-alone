```{r chunk-setup, echo = FALSE}
knitr::opts_chunk$set (
    echo = FALSE, message = FALSE, warning = FALSE,
    fig.align = "center", fig.width = 9, fig.height = 4, dpi = 150,
    fig.path = "review-dividend-figures/"
)
```

```{r load-package}
library (peerreview)
```

<div class="callout">
This vignette draws on a large, locally-fetched dataset
(`repo-data-out/`: every GitHub issue ever opened on ~50,000 repositories
across CRAN, npm, PyPI, JOSS and rOpenSci) that is far too large to ship
with the package itself. The vignette you're reading is precompiled from
that data - see `vignettes/review-dividend.Rmd.orig` in the package
source if you want to re-run the analysis yourself once the underlying
data is available (via Git LFS) from the package repository.
</div>

```{r initial-data-load}
out_dir <- "../repo-data-out"
repo_tbl <- build_repo_tbl (out_dir)
issue_authors_tbl <- readr::read_csv (
    file.path (out_dir, "issue-authors.csv"),
    show_col_types = FALSE, progress = FALSE
)
ropensci_raw <- readr::read_csv (
    file.path (out_dir, "ropensci.csv"),
    show_col_types = FALSE, progress = FALSE
)

primary_sources <- c ("cran", "joss", "npm", "pypi", "ropensci")
n_repos_primary <- length (unique (
    repo_tbl$repo_url [repo_tbl$source %in% primary_sources]
))
n_noncore <- nrow (dplyr::filter (issue_authors_tbl, contribution <= 0.01))
date_range <- range (as.Date (issue_authors_tbl$created_at), na.rm = TRUE)
```



```{r generate-data, include=FALSE}
# Cross-source fold-change (rate now vs. Jan 2021), both metrics
contrib_threshold <- 0.01
fc_issues <- fold_change_tbl (
    issue_authors_tbl,
    repo_tbl,
    primary_sources,
    metric = "issues",
    contrib_threshold = contrib_threshold
) |>
    dplyr::mutate (metric = "Issues")
fc_comments <- fold_change_tbl (
    issue_authors_tbl,
    repo_tbl,
    primary_sources,
    metric = "comments",
    contrib_threshold = contrib_threshold
) |>
    dplyr::mutate (metric = "Comments")
fc_all <- dplyr::bind_rows (fc_issues, fc_comments)
fc_all$metric <- factor (fc_all$metric, levels = c ("Issues", "Comments"))

# Matched-cohort age-vs-calendar-time analysis
cohort_tbl <- cohort_age_rate_tbl (issue_authors_tbl, repo_tbl, primary_sources)

# rOpenSci: reviewed vs. non-reviewed, both metrics
ros_issues <- ropensci_reviewed_activity_tbl (
    issue_authors_tbl, repo_tbl, ropensci_raw, metric = "issues"
)
ros_comments <- ropensci_reviewed_activity_tbl (
    issue_authors_tbl, repo_tbl, ropensci_raw, metric = "comments"
)
ros_trend_all <- dplyr::bind_rows (
    dplyr::mutate (ros_issues, metric = "Issues"),
    dplyr::mutate (ros_comments, metric = "Comments")
)
ros_trend_all$metric <- factor (ros_trend_all$metric, levels = c ("Issues", "Comments"))

ros_fc_issues <- ropensci_reviewed_fold_change_tbl (ros_issues) |> dplyr::mutate (metric = "Issues")
ros_fc_comments <- ropensci_reviewed_fold_change_tbl (ros_comments) |> dplyr::mutate (metric = "Comments")
ros_fc_all <- dplyr::bind_rows (ros_fc_issues, ros_fc_comments)
ros_fc_all$metric <- factor (ros_fc_all$metric, levels = c ("Issues", "Comments"))

# Repo counts by review status, for prose below
ropensci_repo_created <- issue_authors_tbl |>
    dplyr::filter (!is.na (repo_created_at)) |>
    dplyr::distinct (repo_url, repo_created_at)
ropensci_repos <- repo_tbl |>
    dplyr::filter (source == "ropensci") |>
    dplyr::distinct (repo_url, .keep_all = TRUE) |>
    dplyr::inner_join (ropensci_repo_created, by = "repo_url") |>
    dplyr::filter (!is.na (stars)) |>
    dplyr::left_join (dplyr::select (ropensci_raw, repo_url, reviewed), by = "repo_url") |>
    dplyr::filter (!is.na (reviewed))
n_reviewed <- sum (ropensci_repos$reviewed)
n_not_reviewed <- sum (!ropensci_repos$reviewed)
n_reviewed_q1 <- sum (ropensci_repos$reviewed & popularity_strata (ropensci_repos$stars, 4L) == "Q1")
n_not_reviewed_q1 <- sum (!ropensci_repos$reviewed & popularity_strata (ropensci_repos$stars, 4L) == "Q1")
```

<style>
