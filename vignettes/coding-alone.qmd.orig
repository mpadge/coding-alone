<!--
This is the LIVE source for the "coding-alone" vignette. It is not built
directly by R CMD build/check - it requires repo-data-out/, which is far
too large to ship with the package (see the data-access note in the
vignette itself). Instead it's precompiled once, on a machine that has that
data, into the static vignettes/coding-alone.qmd that actually ships:

    knitr::knit ("vignettes/coding-alone.qmd.orig", output = "vignettes/coding-alone.qmd")

run with the working directory set to vignettes/, so relative paths below
resolve correctly. That committed .qmd has every chunk already evaluated
(text and figures baked in as static markdown/images), so re-building it
via the usual vignette machinery (now the `quarto::html` vignette engine)
never needs the data again.
-->

```{r chunk-setup, echo = FALSE}
knitr::opts_chunk$set (
    echo = FALSE,
    message = FALSE,
    warning = FALSE,
    fig.align = "center",
    fig.width = 9,
    fig.height = 4,
    dpi = 150,
    fig.path = "coding-alone-figures/",
    cache.path = "coding-alone-cache/",
    autodep = TRUE
)
options (knitr.kable.NA = "-")

# `knitr::knit()`'s default plot hook wraps figures in raw HTML
# (<div class="figure">...<img>...</div>), which carries no crossref
# target. Emit plain pandoc/quarto figure markdown instead
# (`![cap](path){#id attrs}`), so a `fig-`-prefixed chunk label survives
# this precompilation step as a valid `@fig-*` crossref target once the
# baked, data-free .qmd is later rendered for real by the `quarto::html`
# vignette engine.
knitr::knit_hooks$set (plot = function (x, options) {
    cap <- options$fig.cap
    if (is.null (cap) || !nzchar (cap)) {
        cap <- paste ("plot of chunk", options$label)
    }
    attrs <- character ()
    if (grepl ("^fig-", options$label)) {
        attrs <- c (attrs, paste0 ("#", options$label))
    }
    if (!is.null (options$fig.align) && options$fig.align != "default") {
        attrs <- c (attrs, sprintf ('fig-align="%s"', options$fig.align))
    }
    attr_str <- if (length (attrs) > 0) paste0 ("{", paste (attrs, collapse = " "), "}") else ""
    sprintf ("![%s](%s)%s\n", cap, x, attr_str)
})
```


```{r load-package}
library (codingAlone)
```

<style>
.callout {
    border-left: 4px solid #2c3e50;
    background: #f7f9fa;
    padding: 0.8em 1.2em;
